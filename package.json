{
  "name": "nyayasetu",
  "version": "1.0.0",
  "description": "NyayaSetu — Bridge to Justice. AI-powered Indian legal document platform.",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "worker"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "dev:worker": "npm run dev --workspace=worker",
    "dev:all": "concurrently \"npm run dev:server\" \"npm run dev:client\" \"npm run dev:worker\"",
    "build": "npm run build --workspace=client",
    "start:server": "npm run start --workspace=server",
    "start:worker": "npm run start --workspace=worker",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "seed": "node scripts/seed.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
